def ensure_backend_is_running():
    health_url = 'http://127.0.0.1:8000/health'
    try:
        response = requests.get(health_url, timeout=2)
    except requests.ConnectionError:
        project_root = Path(__file__).resolve().parent
        print('JobPylot backend is stopped. Starting it now...')
        try:
            process = subprocess.Popen(
                [
                    sys.executable,
                    '-m',
                    'uvicorn',
                    'backend.main:app',
                    '--host',
                    '127.0.0.1',
                    '--port',
                    '8000',
                ],
                cwd=project_root,
            )
        except OSError as error:
            raise RuntimeError(
                f'The JobPylot backend could not be started: {error}'
            ) from error

        startup_deadline = time.monotonic() + 15
        while time.monotonic() < startup_deadline:
            if process.poll() is not None:
                raise RuntimeError(
                    'The JobPylot backend stopped while starting. '
                    'Check that FastAPI and Uvicorn are installed in this Python environment.'
                )
            try:
                response = requests.get(
                    health_url,
                    timeout=min(2, startup_deadline - time.monotonic()),
                )
                break
            except (requests.ConnectionError, requests.Timeout):
                time.sleep(0.25)
        else:
            raise RuntimeError(
                'The JobPylot backend did not become ready within 15 seconds.'
            )

    response.raise_for_status()
    health_data = response.json()
    if not isinstance(health_data, dict) or health_data.get('status') != 'ok':
        raise RuntimeError('The local service on port 8000 is not the JobPylot backend.')

