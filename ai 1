def is_experience_stage(value):
    normalized_value = re.sub(r'[^a-z0-9+]+', ' ', value.casefold()).strip()
    stage_labels = {
        'beginner',
        'beginner level',
        'entry level',
        'entry level work experience',
        'first time job seeker',
        'no work experience',
        'no work experience yet',
        'student seeking experience',
        'recent graduate',
        'internship experience',
        'freelance or contract work',
        'self employed',
        'volunteer experience',
        'part time work',
        'remote work experience',
    }
    return (
        normalized_value in stage_labels
        or normalized_value.startswith('beginner at ')
        or bool(re.fullmatch(
            r'\d+\+? (?:\d+ )?years? of experience',
            normalized_value,
        ))
    )


def professional_title(value):
    known_names = {
        'c#': 'C#',
        'c++': 'C++',
        'javascript': 'JavaScript',
        'node.js': 'Node.js',
        'power bi': 'Power BI',
    }
    if value.strip().casefold() in known_names:
        return known_names[value.strip().casefold()]

    title = ' '.join(value.split()).title()
    acronyms = {
        'Ai': 'AI',
        'Api': 'API',
        'Bsc': 'BSc',
        'Css': 'CSS',
        'Csv': 'CSV',
        'Html': 'HTML',
        'Ios': 'iOS',
        'Javascript': 'JavaScript',
        'Js': 'JavaScript',
        'Mba': 'MBA',
        'Msc': 'MSc',
        'Phd': 'PhD',
        'Sql': 'SQL',
        'Ui': 'UI',
        'Ux': 'UX',
    }
    formatted_words = []
    for index, word in enumerate(title.split()):
        if index and word.casefold() in {'in', 'of', 'and', 'for', 'at'}:
            formatted_words.append(word.casefold())
        else:
            formatted_words.append(acronyms.get(word, word))
    return ' '.join(formatted_words)


def professional_institution_name(value):
    small_words = {'and', 'at', 'for', 'in', 'of', 'the', 'to'}

    def capitalize_word(match):
        word = match.group(0)
        if word.casefold() in small_words:
            return word.casefold()
        if word.isupper() and len(word) > 1:
            return word
        return word[0].upper() + word[1:].lower()

    return re.sub(r'[A-Za-z]+', capitalize_word, ' '.join(value.split()))


