def career_title_matches(job_title, career_title):
    job_variants = re.split(r'\s*(?:/|\bor\b)\s*', job_title, flags=re.IGNORECASE)
    career_variants = re.split(r'\s*(?:/|\bor\b)\s*', career_title, flags=re.IGNORECASE)
    return any(
        normalize_career_title(job_variant) == normalize_career_title(career_variant)
        for job_variant in job_variants
