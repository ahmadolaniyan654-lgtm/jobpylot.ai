            print('Enter an actual job title, not a career stage or experience level.')
        company_name = input('Enter your company or organisation name: ').strip()
        work_location = input('Enter the job location: ').strip()
        start_date = input('Enter your start date: ').strip()
        end_date = input('Enter your end date (or current): ').strip()
        responsibilities = input(
            'Describe your responsibilities and achievements: '
        ).strip()
        cv_data['work_experience'].append({
            'job_title': job_title,
            'company_name': company_name,
            'location': work_location,
            'start_date': start_date,
            'end_date': end_date,
            'responsibilities': responsibilities,
        })
    else:
        print(
            'No problem! We can highlight your education, skills and projects instead.'
        )

    print('\n----- SKILLS -----')
    cv_skills = input('Enter your skills, separated by commas: ').strip()
    cv_data['skills'] = [
        skill.strip() for skill in cv_skills.split(',') if skill.strip()
    ]

    print('\n----- PROJECTS AND ACHIEVEMENTS -----')
    if ask_yes_no(
        'Do you have any projects or achievements to include? (yes/no): '
    ) == 'yes':
        while True:
            project = input(
                'Describe a project or achievement, or press Enter to finish: '
            ).strip()
            if not project:
                break
            cv_data['projects_and_achievements'].append(project)
            if ask_yes_no('Add another project or achievement? (yes/no): ') == 'no':
                break

    print('\n----- PROFESSIONAL SUMMARY -----')
    professional_summary = generate_professional_summary(cv_data)
    print(professional_summary)
    edited_summary = input(
        'Press Enter to use this summary, or type an edited version: '
    ).strip()
    if edited_summary:
        professional_summary = edited_summary
    cv_data['professional_summary'] = professional_summary

    personal_details = cv_data['personal_details']
    contact_details = [
        personal_details[field]
        for field in ('email', 'phone', 'location', 'linkedin', 'portfolio')
        if personal_details[field]
    ]
    education = cv_data['education']
    education_details = []
    qualification_text = professional_title(education['qualification'])
    course_text = professional_title(education['course'])
    if course_text and course_text.casefold() in qualification_text.casefold():
        course_text = ''
    qualification_and_course = ' in '.join(
        value for value in (qualification_text, course_text) if value
    )
    if qualification_and_course:
        education_details.append(qualification_and_course)
    for field, label in (
        ('primary_school', 'Primary school'),
        ('secondary_school', 'Secondary school'),
        ('institution', 'University / tertiary institution'),
    ):
        if education[field]:
            education_details.append(
                f'{label}: {professional_institution_name(education[field])}'
            )
    if education['graduation_year']:
        year_match = re.search(
            r'\b(?:19|20|21)\d{2}\b',
            education['graduation_year'],
        )
        if year_match and int(year_match.group(0)) > date.today().year:
            education_details.append(
                f'Expected graduation: {year_match.group(0)}'
            )
        else:
            education_details.append(
                f'Graduation year: {education["graduation_year"]}'
            )
    cv_sections = [
        ('PROFESSIONAL SUMMARY', [cv_data['professional_summary']]
         if cv_data['professional_summary'] else []),
        ('TARGET ROLE', [cv_data['target_role']] if cv_data['target_role'] else []),
        ('CAREER GOAL', [cv_data['career_goal']] if cv_data['career_goal'] else []),
        ('EDUCATION', [detail for detail in education_details if detail]),
    ]

    if cv_data['work_experience']:
        work_experience_details = []
        for experience in cv_data['work_experience']:
            details = [
                ' | '.join(
                    value for value in (
                        experience['job_title'],
                        experience['company_name'],
                    ) if value
                ),
                experience['location'],
                ' - '.join(
                    value for value in (
                        experience['start_date'],
                        experience['end_date'],
                    ) if value
                ),
                experience['responsibilities'],
            ]
            work_experience_details.extend(
                detail for detail in details if detail
            )
        cv_sections.append(('WORK EXPERIENCE', work_experience_details))

    if cv_data['skills']:
        cv_sections.append(('SKILLS', [', '.join(cv_data['skills'])]))

    if cv_data['projects_and_achievements']:
        cv_sections.append((
            'PROJECTS AND ACHIEVEMENTS',
            [f'- {project}' for project in cv_data['projects_and_achievements']],
        ))

    print('\n----- CV PREVIEW -----')
    print(personal_details['full_name'] or 'Curriculum Vitae')
    if contact_details:
        print(' | '.join(contact_details))
    for heading, items in cv_sections:
        if items:
            print(f'\n{heading}')
            for item in items:
                print(item)

    save_cv_pdf(cv_data, cv_sections)
elif cv_choice == '2':
    print(
        'Existing CV review is not implemented yet. No existing CV has '
        'been provided or reviewed.'
    )
else:
    print('Invalid choice. Please choose 1 or 2.')
