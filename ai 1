def save_cv_pdf(cv_data, cv_sections):
    from html import escape
    from pathlib import Path

    try:
        from reportlab.lib import colors
        from reportlab.lib.enums import TA_LEFT
        from reportlab.lib.pagesizes import A4
        from reportlab.lib.styles import ParagraphStyle, getSampleStyleSheet
        from reportlab.lib.units import mm
        from reportlab.platypus import (
            Paragraph,
            SimpleDocTemplate,
            Spacer,
        )
    except ImportError:
        print(
            'PDF creation needs ReportLab. Install the project dependencies '
            'with: .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt'
        )
        return

    documents_dir = Path.home() / 'Documents' / 'JobPylot CVs'
    full_name = cv_data['personal_details']['full_name']
    safe_name = re.sub(r'[^A-Za-z0-9_-]+', '_', full_name).strip('_')
    filename_stem = f'{safe_name or "JobPylot"}_CV'
    output_path = documents_dir / f'{filename_stem}.pdf'
    suffix = 2

    try:
        documents_dir.mkdir(parents=True, exist_ok=True)
        while output_path.exists():
            output_path = documents_dir / f'{filename_stem}_{suffix}.pdf'
            suffix += 1

        styles = getSampleStyleSheet()
        title_style = ParagraphStyle(
            'CVTitle',
            parent=styles['Title'],
            alignment=TA_LEFT,
            textColor=colors.HexColor('#17365D'),
            fontSize=22,
            leading=27,
            spaceAfter=5,
        )
        contact_style = ParagraphStyle(
            'CVContact',
            parent=styles['BodyText'],
            textColor=colors.HexColor('#52606D'),
            fontSize=9,
            leading=13,
            spaceAfter=12,
        )
        heading_style = ParagraphStyle(
            'CVSectionHeading',
            parent=styles['Heading2'],
            textColor=colors.HexColor('#176B87'),
            fontSize=12,
            leading=16,
            spaceBefore=10,
            spaceAfter=5,
            keepWithNext=True,
        )
        body_style = ParagraphStyle(
            'CVBody',
            parent=styles['BodyText'],
            textColor=colors.HexColor('#263238'),
            fontSize=10,
            leading=14,
            spaceAfter=4,
        )
        story = []
        if full_name:
            story.append(Paragraph(escape(full_name), title_style))
        else:
            story.append(Paragraph('Curriculum Vitae', title_style))

        contact_details = [
            cv_data['personal_details'][field]
            for field in ('email', 'phone', 'location', 'linkedin', 'portfolio')
            if cv_data['personal_details'][field]
        ]
        if contact_details:
            story.append(
                Paragraph(escape(' | '.join(contact_details)), contact_style)
            )
        else:
            story.append(Spacer(1, 8))

        for heading, items in cv_sections:
            if not items:
                continue
            story.append(Paragraph(escape(heading), heading_style))
            for item in items:
                safe_item = escape(item).replace('\n', '<br/>')
                story.append(Paragraph(safe_item, body_style))

        document = SimpleDocTemplate(
            str(output_path),
            pagesize=A4,
            rightMargin=20 * mm,
            leftMargin=20 * mm,
            topMargin=18 * mm,
            bottomMargin=18 * mm,
            title=f'{full_name or "JobPylot"} CV',
            author=full_name,
        )
        document.build(story)
    except OSError as error:
        print(f'Could not save the CV PDF: {error}')
    else:
        print(f'Your CV PDF was saved to: {output_path}')


