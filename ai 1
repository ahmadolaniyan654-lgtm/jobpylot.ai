import re
from datetime import date

def normalize_skill(skill):
    """Normalize punctuation and generic wording for exact skill phrase matching."""
    words = re.sub(r'[^a-z0-9]+', ' ', skill.lower()).split()
    words = [word for word in words if word not in ('skill', 'skills')]
    return ' '.join(words)


def print_skill_recommendation(job_title, skills):
    missing_skills = []
    for actual_skill, display_skill in skills:
        normalized_skill = normalize_skill(actual_skill)
        normalized_user_skills = normalize_skill(user_skills)
        if f' {normalized_skill} ' not in f' {normalized_user_skills} ':
            missing_skills.append(display_skill)
    if not missing_skills:
        return
    if len(missing_skills) == 1:
        skill_text = missing_skills[0]
    elif len(missing_skills) == 2:
        skill_text = missing_skills[0] + ' and ' + missing_skills[1]
    else:
        skill_text = ', '.join(missing_skills[:-1]) + ', and ' + missing_skills[-1]
    print(f'You should learn {skill_text} to improve your chances of getting a {job_title} job.')

